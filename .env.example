# Local preview only. Hosted demo access is always disabled.
UNICIRQ_DEMO_MODE=true
APP_URL=http://127.0.0.1:3000
# Prisma ORM uses standard PostgreSQL TCP connections, including Prisma Postgres.
# Use a restricted runtime login; remote URL needs database name and sslmode=verify-full.
# Pooled runtime: postgresql://LOGIN:PASSWORD@HOST/DATABASE?sslmode=verify-full
DATABASE_URL=
BETTER_AUTH_SECRET=
# Email/password, verification, email-code sign-in and password recovery.
RESEND_API_KEY=
EMAIL_FROM=
# Google Cloud Console: OAuth client type Web application.
# Callback: APP_URL/api/auth/callback/google (exact scheme, host and port).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local operator only: separate privileged direct connection for SQL migrations.
# Never add this variable to the hosted app runtime.
MIGRATION_DATABASE_URL=
