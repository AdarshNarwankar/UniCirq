# Local preview only. Hosted demo access is always disabled.
UNICIRQ_DEMO_MODE=true
APP_URL=http://127.0.0.1:3000
# Standard PostgreSQL with Prisma ORM. Use a restricted runtime login.
# Remote URLs must include an explicit database name and sslmode=verify-full.
# Example format: postgresql://LOGIN:PASSWORD@HOST/DATABASE?sslmode=verify-full
DATABASE_URL=
BETTER_AUTH_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
# Local operator only. Separate owner login, direct connection for migrations.
# Do not add this variable to Vercel or any hosted application runtime.
MIGRATION_DATABASE_URL=
