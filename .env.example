# Local preview only. Hosted demo access is always disabled.
UNICIRQ_DEMO_MODE=true
APP_URL=http://127.0.0.1:3000
# Prisma ORM uses standard PostgreSQL TCP connections, including Prisma Postgres.
# Use a restricted runtime login; remote URL needs database name and sslmode=verify-full.
# Pooled runtime: postgresql://LOGIN:PASSWORD@HOST/DATABASE?sslmode=verify-full
DATABASE_URL=
BETTER_AUTH_SECRET=
# Email/password, verification, email-code sign-in and password recovery.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
# Temporary Gmail SMTP testing: set EMAIL_PROVIDER=gmail and match EMAIL_FROM to GMAIL_USER.
# Enable Google 2-Step Verification, then create an App Password. Never use your Google password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Google Cloud Console: OAuth client type Web application.
# Callback: APP_URL/api/auth/callback/google (exact scheme, host and port).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local operator only: separate privileged direct connection for SQL migrations.
# Never add this variable to the hosted app runtime.
MIGRATION_DATABASE_URL=
# Razorpay test mode only. Live keys are deliberately rejected by this release.
# Generate a separate random webhook secret of at least 32 characters.
# Webhook URL: APP_URL/api/billing/webhook
# Subscribe to payment.captured, order.paid and refund.processed in TEST mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
