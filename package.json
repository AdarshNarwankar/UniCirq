{
  "name": "unicirq",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "prisma generate && tsx --test tests/*.test.ts",
    "test:db": "tsx --test tests/database.test.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.mjs",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:check": "node --env-file-if-exists=.env.local --import tsx scripts/check-database.ts",
    "setup:check": "node --env-file-if-exists=.env.local --import tsx scripts/check-setup.ts",
    "email:check": "node --env-file-if-exists=.env.local --import tsx scripts/check-email.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.14",
    "jose": "^6.1.3",
    "lucide-react": "^0.577.0",
    "next": "16.4.3",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prisma": "7.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "overrides": {
    "prisma@7.10.0": {
      "mysql2": "3.24.5"
    },
    "@prisma/config@7.10.0": {
      "deepmerge-ts": "8.0.0"
    }
  }
}
